# Optional convenience for Bash: source /path/to/MagicLamp/magiclamp.paths
# Libraries are resolved relative to the running code, not the working directory.
MAGICLAMP_CHECKOUT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
case ":$PATH:" in
    *":$MAGICLAMP_CHECKOUT:"*) ;;
    *) export PATH="$MAGICLAMP_CHECKOUT:$PATH" ;;
esac
unset MAGICLAMP_CHECKOUT
